// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderDockerfile > renders the alpine layout (snapshot) 1`] = `
"# Generated by abox. Do not edit.
FROM alpine:3.22
LABEL abox.managed="1" abox.template="abox-test-alpine" abox.template-hash="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
# user
RUN f=/tmp/.abox-step-$$ && printf %s '' | base64 -d > "$f" && { sh -e "$f"; rc=$?; rm -f "$f"; exit $rc; }
# step: marker
RUN f=/tmp/.abox-step-$$ && printf %s 'ZWNobyAiYnVpbHQgYnkgYWJveCB0ZXN0IiA+IC9ldGMvYWJveC1tYXJrZXI=' | base64 -d > "$f" && { sh -e "$f"; rc=$?; rm -f "$f"; exit $rc; }
# step: quoting
RUN f=/tmp/.abox-step-$$ && printf %s 'ZWNobyAnaXQnIiciJ3MgJEhPTUUgInF1b3RlZCInID4gL2V0Yy9hYm94LXF1b3Rl' | base64 -d > "$f" && { sh -e "$f"; rc=$?; rm -f "$f"; exit $rc; }
# workspace
RUN mkdir -p '/workspace' '/usr/local/share/abox' && chown 1000:1000 '/workspace' && chmod 755 '/usr/local/share/abox'
USER 1000:1000
WORKDIR /workspace
"
`;

exports[`renderDockerfile > renders the debian layout (snapshot) 1`] = `
