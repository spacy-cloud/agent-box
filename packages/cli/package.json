{
  "name": "@abox/cli",
  "version": "0.1.0",
  "description": "abox command line interface",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && chmod +x dist/bin.js"
  },
  "dependencies": {
    "@abox/backend-docker": "workspace:*",
    "@abox/backend-process": "workspace:*",
    "@abox/core": "workspace:*",
    "@abox/mcp": "workspace:*",
    "@abox/runtime": "workspace:*",
    "commander": "^15.0.0"
  },
  "bin": {
    "abox": "./dist/bin.js"
  }
}
