{
  "name": "@abox/app",
  "version": "0.1.0",
  "description": "abox desktop GUI (Electron): sandboxes, approvals, audit, policy, diagnostics",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && xvfb-run -a --server-args=\"-screen 0 1600x1000x24\" playwright test",
    "native": "node scripts/ensure-native.mjs",
    "postinstall": "node scripts/ensure-native.mjs --soft",
    "dist": "pnpm run native && pnpm run build && electron-builder --config electron-builder.yml --linux AppImage dir --x64",
    "dist:dir": "pnpm run native && pnpm run build && electron-builder --config electron-builder.yml --linux dir --x64",
    "smoke": "node scripts/smoke-appimage.mjs"
  },
  "dependencies": {
    "@abox/backend-docker": "workspace:*",
    "@abox/core": "workspace:*",
    "@abox/runtime": "workspace:*",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "axe-core": "^4.14.0",
    "codemirror": "^6.0.2",
    "electron": "44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0",
    "jsdom": "^30.1.3",
    "node-gyp": "^13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "author": "abox contributors",
  "homepage": "https://github.com/spacy-cloud/agent-box"
}
