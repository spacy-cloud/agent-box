{
  "name": "@abox/app",
  "version": "0.1.0",
  "description": "abox desktop GUI (Electron): sandboxes, approvals, audit, policy, diagnostics",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && xvfb-run -a --server-args=\"-screen 0 1600x1000x24\" playwright test"
  },
  "dependencies": {
    "@abox/core": "workspace:*",
    "@abox/runtime": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "^4.14.0",
    "electron": "44.8.0",
    "electron-vite": "6.0.0",
    "jsdom": "^30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "~6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "^4.6.7"
  }
}
