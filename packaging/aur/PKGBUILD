# Maintainer: SPACY.CLOUD <https://github.com/spacy-cloud>
#
# abox-git: builds the abox CLI (and the MCP server it contains) from the git source.
# abox is pre-release software; this package tracks the default branch. See packaging/README.md.

pkgname=abox-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Agent Sandbox Manager: local, policy-controlled sandboxes for AI agents (CLI and MCP server)'
arch=('x86_64' 'aarch64')
url='https://github.com/spacy-cloud/agent-box'
license=('MIT')
depends=('nodejs>=24')
makedepends=('git' 'pnpm' 'python' 'make' 'gcc')
optdepends=(
  'docker: container backend (default for most templates)'
  'podman: container backend (not verified against a real Podman)'
  'qemu-system-x86: VM backend (needs /dev/kvm, x86_64 only)'
  'dosfstools: build images for the VM backend'
  'mtools: build images for the VM backend'
  'socat: faster allowlist relay for the VM backend'
  'libsecret: secret-tool, for secrets in the desktop keyring'
  'openssh: remote hosts over SSH'
  'git: workspace modes clone/worktree and export to a branch'
  'uv: Python backend in venv mode'
)
provides=('abox')
conflicts=('abox')
options=('!strip' '!debug')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  local v
  v=$(node -p "require('./packages/cli/package.json').version")
  printf '%s.r%s.g%s' "$v" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$srcdir/$pkgname"
  # Do not let pnpm download the exact version named in package.json; use the packaged one.
  export npm_config_manage_package_manager_versions=false
  # Only the CLI and what it needs (not the Electron app), plus the root for TypeScript.
  pnpm install --frozen-lockfile --store-dir "$srcdir/pnpm-store" \
    --filter '@abox/cli...' --filter abox-monorepo
  pnpm exec tsc -b packages/cli
}

package() {
  cd "$srcdir/$pkgname"
  export npm_config_manage_package_manager_versions=false

  # A self-contained tree with production dependencies only (relative symlinks, relocatable).
  pnpm --filter @abox/cli deploy --prod --legacy --store-dir "$srcdir/pnpm-store" \
    "$pkgdir/usr/lib/abox"
  # Remove build-time artefacts that embed the build directory.
  find "$pkgdir/usr/lib/abox/node_modules" -type d -name .bin -prune -exec rm -rf {} +
  rm -f "$pkgdir/usr/lib/abox/node_modules/.modules.yaml"
  chmod 755 "$pkgdir/usr/lib/abox/dist/bin.js"

  # Wrapper: does not depend on the executable bit or on the shebang lookup.
  install -d "$pkgdir/usr/bin"
  printf '#!/bin/sh\nexec /usr/bin/node /usr/lib/abox/dist/bin.js "$@"\n' > "$pkgdir/usr/bin/abox"
  chmod 755 "$pkgdir/usr/bin/abox"

  # Shell completions, generated by the CLI itself (it creates no state for this command).
  local cli="node packages/cli/dist/bin.js"
  export ABOX_HOME="$srcdir/abox-home"
  install -d "$pkgdir/usr/share/bash-completion/completions" \
    "$pkgdir/usr/share/zsh/site-functions" \
    "$pkgdir/usr/share/fish/vendor_completions.d"
  $cli completion bash > "$pkgdir/usr/share/bash-completion/completions/abox"
  $cli completion zsh  > "$pkgdir/usr/share/zsh/site-functions/_abox"
  $cli completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/abox.fish"

  # License, documentation and the Claude Code plugin (use with: claude --plugin-dir /usr/share/abox/agent-kit).
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/abox/README.md"
  install -d "$pkgdir/usr/share/doc/abox/docs"
  cp -r docs/*.md "$pkgdir/usr/share/doc/abox/docs/"
  install -d "$pkgdir/usr/share/abox"
  cp -r packages/agent-kit "$pkgdir/usr/share/abox/agent-kit"
  rm -rf "$pkgdir/usr/share/abox/agent-kit/node_modules" "$pkgdir/usr/share/abox/agent-kit/test"
}
