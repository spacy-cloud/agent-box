{
  "name": "abox-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "abox - Agent Sandbox Manager: local sandboxes for AI agents via CLI, MCP and GUI",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "tsc -b && node scripts/postbuild.mjs",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:docker": "ABOX_TEST_DOCKER=1 vitest run --no-file-parallelism",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
